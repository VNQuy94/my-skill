{
  "name": "modern",
  "description": "Clean sans-serif report style with one accent hue. Default for reports, proposals, guides.",
  "lang": "vi",
  "labels": {
    "table": "Bảng",
    "figure": "Hình",
    "note": "Ghi chú",
    "tip": "Gợi ý",
    "warning": "Lưu ý",
    "danger": "Cảnh báo",
    "success": "Kết quả"
  },
  "page": {
    "paper": "a4",
    "margin_mm": {
      "top": 22,
      "bottom": 22,
      "left": 22,
      "right": 22
    },
    "page_numbers": "bottom-center",
    "number_first_page": true
  },
  "fonts": {
    "body": [
      "Inter",
      "Noto Sans",
      "DejaVu Sans"
    ],
    "heading": [
      "Inter",
      "Noto Sans",
      "DejaVu Sans"
    ],
    "mono": [
      "JetBrains Mono",
      "Noto Sans Mono",
      "DejaVu Sans Mono"
    ]
  },
  "sizes_pt": {
    "body": 11,
    "small": 9,
    "h1": 20,
    "h2": 15,
    "h3": 12.5,
    "title": 26,
    "table": 10,
    "code": 9.5
  },
  "spacing": {
    "line": 1.3,
    "paragraph_after_pt": 6,
    "first_line_indent_mm": 0,
    "justify": false,
    "heading_before_pt": {
      "h1": 20,
      "h2": 14,
      "h3": 10
    },
    "heading_after_pt": {
      "h1": 8,
      "h2": 6,
      "h3": 4
    },
    "block_gap_pt": 10
  },
  "headings": {
    "bold": true,
    "numbered": false,
    "max_level": 3
  },
  "colors": {
    "text": "#1F2937",
    "text_muted": "#6B7280",
    "heading": "#111827",
    "accent": "#1D4ED8",
    "accent_soft": "#EFF4FF",
    "border": "#D1D5DB",
    "surface": "#F9FAFB",
    "link": "#1D4ED8",
    "success": "#15803D",
    "success_soft": "#ECFDF3",
    "warning": "#B45309",
    "warning_soft": "#FFF7E6",
    "danger": "#B91C1C",
    "danger_soft": "#FEF2F2"
  },
  "chart_palette": [
    "#1D4ED8",
    "#6B8FEA",
    "#A9BEF4",
    "#9CA3AF",
    "#4B5563"
  ],
  "table": {
    "header_fill": "accent_soft",
    "header_rule": "accent",
    "row_rule": "border",
    "zebra": false,
    "cell_pad_pt": 4
  },
  "callout": {
    "bar_width_pt": 3,
    "pad_pt": 8
  },
  "lint": {
    "wall_of_text": true
  }
}
